{
  "name": "proofscape",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "npm run build:collection",
    "build:collection": "python3 scripts/build_static_collection.py && python3 scripts/build_historical_catalog.py",
    "build:historical-catalog": "python3 scripts/build_historical_catalog.py",
    "merge:proof-extractions": "python3 scripts/merge_proof_extractions.py",
    "prebuild": "npm run build:collection",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
